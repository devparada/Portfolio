{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": false,
  "timezone": "Europe/Madrid",
  "schedule": [
    "* 10 * * 1"
  ],
  "minimumReleaseAge": "1 day",
  "prConcurrentLimit": 2,
  "assignees": [
    "devparada"
  ],
  "reviewers": [
    "devparada"
  ],
  "branchPrefix": "deps/",
  "branchPrefixOld": "renovate/",
  "commitMessagePrefix": "deps:",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDepTypes": [
        "packageManager"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "groupName": "prod",
      "groupSlug": "prod",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev",
      "groupSlug": "dev",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "actions",
      "groupSlug": "actions",
      "addLabels": [
        "github-actions"
      ]
    }
  ]
}
