---
// Animación: las líneas se revelan en cascada al entrar en viewport (data-* en lib/animaciones.ts).
import { STACK_TECNOLOGICO } from "../../constants/constants";

const categorias = Object.entries(STACK_TECNOLOGICO);
const ultima = categorias[categorias.length - 1]?.[0];
---

<div class="terminal-window mono text-sm" data-terminal>
  <div class="terminal-window__bar">
    <span class="terminal-window__title">raul@devparada: ~/skills</span>
  </div>

  <div class="terminal-window__body">
    <div data-terminal-line class="text-faint">{"{"}</div>
    {
      categorias.map(([categoria, items]) => (
        <div data-terminal-line class="pl-4 sm:pl-6 mt-2 first:mt-0">
          <span class="text-accent">"{categoria}"</span>
          <span class="text-faint">: [</span>
          {items.map((item, i) => (
            <>
              <span class="text-ink-soft">"{item}"</span>
              {i < items.length - 1 && <span class="text-faint">, </span>}
            </>
          ))}
          <span class="text-faint">]</span>
          <span class="text-faint">{categoria !== ultima ? "," : ""}</span>
        </div>
      ))
    }
    <div data-terminal-line class="text-faint">{"}"}</div>
  </div>
</div>

<style>
  .text-faint {
    color: var(--color-ink-faint);
  }

  .text-accent {
    color: var(--color-accent);
  }

  .text-ink-soft {
    color: oklch(86% 0.01 285);
  }

  .terminal-window {
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
  }

  .terminal-window__bar {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-rule-soft);
    background: var(--color-paper-3);
  }

  .terminal-window__title {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .terminal-window__body {
    padding: 1.5rem;
    color: var(--color-ink-muted);
    line-height: 1.8;
    overflow-x: auto;
  }
</style>
