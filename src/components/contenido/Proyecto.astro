---
import { Image } from "astro:assets";

const { urlCodigo, urlDemo, urlImg, nombre, descripcion, lenguajes } =
  Astro.props;

// Importa dinámicamente las imagenes
import { imagenes } from "../../lib/imagenes.ts";

const hrefLink = urlDemo || urlCodigo || "#";
---

<article class="project-card">
  <a
    href={hrefLink}
    target="_blank"
    rel="noopener noreferrer"
    class="project-card__link group"
  >
    <figure class="project-card__media">
      <Image
        src={imagenes[urlImg]()}
        alt={`Captura del proyecto: ${nombre}`}
        class="project-card__img"
      />
    </figure>

    <div class="project-card__body">
      <div class="flex items-start justify-between gap-4 mb-3">
        <h3 class="project-card__title">
          {nombre}
        </h3>
        <span class="project-card__arrow" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 3h6v6"></path>
            <path d="M10 14 21 3"></path>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
          </svg>
        </span>
      </div>

      <p class="project-card__desc">{descripcion}</p>

      <div class="flex flex-wrap gap-2 mt-auto pt-5">
        {
          lenguajes.map((lang: { nombre: string }) => (
            <span class="tag">{lang.nombre}</span>
          ))
        }
      </div>
    </div>
  </a>

  <div class="project-card__meta mono" aria-hidden="true">
    <span class="t-prompt">$&nbsp;</span>
    <span class="project-card__meta-links">
      <a href={hrefLink} target="_blank" rel="noopener noreferrer" tabindex="-1">Entrar ↗</a>
    </span>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1px solid var(--color-rule-soft);
    background: var(--color-paper-2);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--color-rule);
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-paper-3);
    border-bottom: 1px solid var(--color-rule-soft);
    margin: 0;
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease-out), filter 0.7s var(--ease-out);
  }

  .project-card:hover .project-card__img {
    transform: scale(1.03);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.375rem;
  }

  .project-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
    min-width: 0;
  }

  .project-card:hover .project-card__title {
    color: var(--color-accent-strong);
  }

  .project-card__arrow {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--color-ink-faint);
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .project-card:hover .project-card__arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }

  .project-card__desc {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    flex-grow: 1;
  }

  .project-card__meta {
    padding: 0.625rem 1.375rem;
    font-size: 0.75rem;
    border-top: 1px solid var(--color-rule-soft);
    color: var(--color-ink-faint);
  }

  .project-card__meta-links a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }

  .project-card:hover .project-card__meta-links a {
    color: var(--color-accent);
  }
</style>
