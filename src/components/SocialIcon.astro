---
interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
}

const { href, label, target = "_blank", rel = "noopener noreferrer" } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? rel : undefined}
  aria-label={label}
  class="text-gray-400 hover:text-purple-400 transition-all hover:scale-110"
>
  <slot />
</a>
