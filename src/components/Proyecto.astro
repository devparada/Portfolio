---
import { Image } from "astro:assets";

const {
  urlCodigo,
  urlDemo,
  urlImg,
  nombre,
  descripcion,
  lenguajes,
} = Astro.props;

// Importa dinámicamente las imagenes
import { imagenes } from "../lib/imagenes.ts";

const hrefLink = urlDemo || urlCodigo || "#";
---

<a
  href={hrefLink}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex flex-col h-full overflow-hidden rounded-3xl border border-purple-500/10 bg-[#0b0c10]/80 backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:border-purple-500/50 hover:shadow-[0_20px_40px_-10px_rgba(168,85,247,0.4)]"
>
  <div class="relative w-full aspect-video overflow-hidden bg-purple-500/5">
    <div class="absolute inset-0 bg-linear-to-t from-[#0b0c10] to-transparent opacity-60 z-10 transition-opacity duration-500 group-hover:opacity-20"></div>
    <Image
      src={imagenes[urlImg]()}
      alt={nombre}
      class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
    />
  </div>

  <div class="flex flex-col grow p-6">
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="text-xl font-bold text-white group-hover:text-purple-400 transition-colors">
        {nombre}
      </h3>
      <div class="mt-1 shrink-0 text-gray-500 group-hover:text-purple-400 transition-colors">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </div>
    </div>
    
    <p class="text-gray-400 text-sm leading-relaxed mb-6 grow">
      {descripcion}
    </p>

    <div class="flex flex-wrap gap-2 mt-auto">
      {
        lenguajes.map((lang: { nombre: string }) => (
          <span class="px-3 py-1 rounded-full bg-[#1f2937] text-gray-300 text-xs font-medium border border-gray-700/50">
            {lang.nombre}
          </span>
        ))
      }
    </div>
  </div>
</a>
