---
import { REDES_SOCIALES } from "../../constants/constants";
import Mail from "@lucide/astro/icons/mail";
import LinkedinIcon from "../ui/icons/LinkedinIcon.astro";
import DiscordIcon from "../ui/icons/DiscordIcon.astro";
import LineaCreditos from "../ui/LineaCreditos.astro";

// slim: solo la barra de créditos (p. ej. la 404), sin sección de contacto.
interface Props {
  slim?: boolean;
}

const { slim = false } = Astro.props;
---

{
  slim ? (
    <footer class="relative bg-[color:var(--color-paper)] border-t border-[color:var(--color-rule-soft)] px-6 py-10 md:px-12 lg:px-16">
      <LineaCreditos />
    </footer>
  ) : (
    <footer
      id="contacto"
      class="relative px-6 py-24 md:py-32 md:px-12 lg:px-16 overflow-hidden bg-[color:var(--color-paper)] border-t border-[color:var(--color-rule-soft)]"
    >
      <div class="max-w-4xl mx-auto flex flex-col items-center text-center relative z-10">
        <h2 class="text-4xl md:text-6xl font-bold tracking-tight text-balance max-w-3xl">
          ¿Trabajamos juntos?
        </h2>
        <p class="text-[color:var(--color-ink-muted)] text-lg md:text-xl max-w-2xl text-pretty leading-relaxed mt-6">
          Si tienes una idea en mente, un proyecto en curso o simplemente
          quieres saludar, mi bandeja de entrada siempre está abierta.
          Construyamos algo increíble juntos.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mt-12">
          <a
            href={`mailto:${REDES_SOCIALES.email}`}
            class="btn-solid text-base px-8 py-4"
            data-cta-email
          >
            <Mail size={18} aria-hidden="true" />
            Enviar email
          </a>

          <a
            href={REDES_SOCIALES.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-base px-8 py-4"
          >
            <LinkedinIcon size={18} />
            LinkedIn
          </a>

          <!-- Discord: lucide no incluye iconos de marca -->
          <a
            href={REDES_SOCIALES.discord}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-base px-8 py-4"
          >
            <DiscordIcon size={18} />
            Discord
          </a>
        </div>

        <LineaCreditos class="mt-16" />
      </div>
    </footer>
  )
}
