---
import Proyecto from "./contenido/Proyecto.astro";
import Footer from "./estructura/Footer.astro";
import Hero from "./secciones/Hero.astro";
import StackTerminal from "./secciones/StackTerminal.astro";
import SeccionHeader from "./ui/SeccionHeader.astro";
import Certificaciones from "./secciones/Certificaciones.astro";
import { PROYECTOS } from "../constants/constants";
---

<main id="inicio" class="w-full relative">
  <!-- Rejilla técnica sutil de fondo -->
  <div
    class="pointer-events-none absolute inset-0 bg-grid"
    aria-hidden="true"
  >
  </div>

  <Hero />

  <!-- Sección Stack -->
  <section
    class="max-w-5xl mx-auto px-6 py-16 md:py-20 md:px-12 lg:px-16 relative z-10"
  >
    <SeccionHeader ruta="skills.json" titulo="Herramientas que utilizo" />
    <StackTerminal />
  </section>

  <!-- Sección Proyectos -->
  <section
    id="proyectos"
    class="max-w-5xl mx-auto px-6 py-16 md:py-20 md:px-12 lg:px-16"
  >
    <SeccionHeader
      ruta="proyectos"
      titulo="Lo que he construido"
      descripcion="Una selección de mis proyectos personales más destacados."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" data-cards-grid>
      {
        PROYECTOS.map((proyecto) => (
          <Proyecto
            urlCodigo={proyecto.urlCodigo}
            urlDemo={proyecto.urlDemo}
            urlImg={proyecto.urlImg}
            nombre={proyecto.nombre}
            descripcion={proyecto.descripcion}
            lenguajes={proyecto.lenguajes}
          />
        ))
      }
    </div>
  </section>

  <!-- Sección Certificaciones -->
  <Certificaciones rutaTitulo="credenciales" />
  <Footer />
</main>

<style>
  .bg-grid {
    background-image: linear-gradient(
        oklch(100% 0 0 / 0.015) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, oklch(100% 0 0 / 0.015) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 70%);
  }
</style>
