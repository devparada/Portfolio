---
interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
}

const { href, label, target = "_blank", rel = "noopener noreferrer" } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? rel : undefined}
  aria-label={label}
  class="inline-flex items-center justify-center w-8 h-8 -m-2 p-1 text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)] transition-all hover:scale-110"
>
  <slot />
</a>
