---
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Full Stack Developer especializado en React, TypeScript y Node.js. Explora los proyectos y certificaciones de Raúl Parada de la Fuente."
    />
    <link rel="canonical" href="https://devparada.dev/" />
    <link rel="icon" type="image/webp" href="/avatar.webp" />
    <link rel="preload" as="image" href="/avatar.webp" type="image/webp" />
    <title>Raúl Parada de la Fuente | Portfolio</title>

    <!-- Open Graph -->
    <meta property="og:title" content="Raúl Parada de la Fuente - Full Stack Developer" />
    <meta
      property="og:description"
      content="Explora los proyectos y habilidades de Raúl Parada de la Fuente"
    />
    <meta property="og:url" content="https://devparada.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://devparada.dev/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Raúl Parada de la Fuente - Full Stack Developer"
    />
    <meta property="og:site_name" content="Raúl Parada de la Fuente | Portfolio" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Raúl Parada de la Fuente - Full Stack Developer" />
    <meta
      name="twitter:description"
      content="Explora los proyectos y habilidades de Raúl Parada de la Fuente"
    />
    <meta name="twitter:image" content="https://devparada.dev/og.png" />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Raúl Parada de la Fuente",
        url: "https://devparada.dev/",
        jobTitle: "Full Stack Developer",
        sameAs: [
          "https://github.com/devparada/",
          "https://www.linkedin.com/in/raul-parada-de-la-fuente/",
        ],
      })}
    />
  </head>
  <body class="relative">
    <!-- Skip link: accesibilidad de teclado -->
    <a
      href="#inicio"
      class="skip-link"
    >
      Saltar al contenido
    </a>

    <!-- XP bar: progreso de scroll -->
    <div class="xp-bar" id="xp-bar" aria-hidden="true"></div>

    <slot />

    <script>
      // Toda la animación GSAP vive en src/lib/animaciones.ts (imports npm).
      // Estructura centralizada: todos los data-* se animan aquí.
      import "../lib/animaciones";
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
